    {
      "name": "google oath2 get authorisation url",
      "protocolProfileBehavior": {
        "disableBodyPruning": true
      },
      "request": {
        "method": "GET",
        "header": [],
        "body": {
          "mode": "urlencoded",
          "urlencoded": []
        },
        "url": {
          "raw": "{{baseURL}}/api/o/google-oauth2/?redirect_uri=http://localhost:3000/auth/google",
          "host": [
            "{{baseURL}}"
          ],
          "path": [
            "api",
            "o",
            "google-oauth2",
            ""
          ],
          "query": [
            {
              "key": "redirect_uri",
              "value": "http://localhost:3000/auth/google"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Google post request",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseURL}}/api/o/google-oauth2/?state=YOUR_OAUTH_STATE&code=YOUR_AUTH_CODE",
          "host": [
            "{{baseURL}}"
          ],
          "path": [
            "api",
            "o",
            "google-oauth2",
            ""
          ],
          "query": [
            {
              "key": "state",
              "value": "YOUR_OAUTH_STATE"
            },
            {
              "key": "code",
              "value": "YOUR_GOOGLE_OR_MICROSOFT_AUTH_CODE"
            }
          ]
        }
      },
      "response": []
