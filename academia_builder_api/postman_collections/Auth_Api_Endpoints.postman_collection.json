            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"uid\": \"YOUR_USER_UID\",\n    \"token\": \"YOUR_ACTIVATION_OR_RESET_TOKEN\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
