  "item": [
    {
      "name": "endpoint to create an account",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"first_name\": \"Alex\",\n    \"last_name\": \"Taylor\",\n    \"email\": \"student@example.com\",\n    \"account_type\": \"teacher\",\n    \"password\": \"ExamplePassword123!\",\n    \"re_password\": \"ExamplePassword123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseURL}}/api/users/",
          "host": [
            "{{baseURL}}"
          ],
          "path": [
            "api",
            "users",
            ""
          ]
        }
      },
      "response": []
    },
    {
      "name": "endpoint to activate account( must go to email  once an account is created)",
      "request": {
        "method": "POST",
